{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "composite": true,
    "outDir": "./dist/lib/",
    "declarationDir": "dist/lib",
    "rootDir": "./src",
    "tsBuildInfoFile": "../../.build-cache/cacti-plugin-cbdc-controller.tsbuildinfo",
    "paths": {
      "@/*": ["./src/main/typescript/*"],
      "@test/*": ["./src/test/typescript/*"]
    },
    "resolveJsonModule": true,
    "types": ["jest"]
  },
  "include": ["./src", "src/**/*.json"],
  "exclude": ["**/*.test.ts"],
  "references": []
}
